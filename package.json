{
  "name": "gauravide",
  "version": "0.1.0",
  "private": true,
  "description": "Split a receipt in 30 seconds — scan, assign, and push to Splitwise.",
  "scripts": {
    "build": "next build",
    "check:contrast": "node scripts/check-contrast.mjs",
    "clean": "rm -rf .next",
    "db:migrate": "node scripts/migrate.mjs",
    "dev": "next dev",
    "e2e": "npm run clean && npm run build && playwright test",
    "e2e:only": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run check:contrast && npm run test",
    "verify:all": "npm run verify && npm run build && npm run e2e:only && npm run e2e:full",
    "e2e:full": "playwright test -c playwright.full.config.ts",
    "admin:password": "node scripts/admin-password.mjs"
  },
  "dependencies": {
    "next": "15.1.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.18.0",
    "eslint-config-next": "15.1.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "26.0.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  }
}
